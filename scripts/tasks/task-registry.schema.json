{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.invalid/schemas/task-registry.schema.json",
  "title": "MoonWitness Task Registry",
  "type": "object",
  "required": ["schema_version", "registry_id", "project", "execution_policy", "global_gates", "workstreams", "tasks"],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "registry_id": { "type": "string", "minLength": 1 },
    "project": { "type": "object" },
    "execution_policy": { "type": "object" },
    "global_gates": { "type": "array" },
    "workstreams": { "type": "array" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "nullableString": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "nullableTimestamp": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "claim": {
      "type": "object",
      "required": ["agent_id", "claimed_at", "lease_expires_at", "worktree", "branch", "owned_paths"],
      "properties": {
        "agent_id": { "$ref": "#/$defs/nullableString" },
        "claimed_at": { "$ref": "#/$defs/nullableTimestamp" },
        "lease_expires_at": { "$ref": "#/$defs/nullableTimestamp" },
        "worktree": { "$ref": "#/$defs/nullableString" },
        "branch": { "$ref": "#/$defs/nullableString" },
        "owned_paths": { "$ref": "#/$defs/stringList" }
      },
      "additionalProperties": true
    },
    "approval": {
      "type": "object",
      "required": ["approved_by", "approved_at", "scope", "evidence"],
      "properties": {
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" },
        "scope": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": [
        "id", "title", "workstream", "blueprint", "phase", "priority", "status",
        "owner_role", "assigned_agent", "claim", "objective", "scope_in", "scope_out",
        "dependencies", "inputs", "implementation_steps", "deliverables",
        "acceptance_criteria", "verification", "file_ownership", "estimate",
        "parallel_group", "human_approval_required", "evidence", "blocker",
        "notes", "created_at", "updated_at", "completed_at"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "workstream": { "type": "string", "minLength": 1 },
        "blueprint": { "type": "string", "minLength": 1 },
        "phase": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["P0", "P1", "P2"] },
        "status": { "enum": ["pending", "claimed", "in_progress", "blocked", "blocked_policy", "in_review", "done", "deferred", "cancelled"] },
        "owner_role": { "type": "string", "minLength": 1 },
        "assigned_agent": { "$ref": "#/$defs/nullableString" },
        "claim": { "$ref": "#/$defs/claim" },
        "objective": { "type": "string", "minLength": 1 },
        "scope_in": { "$ref": "#/$defs/stringList" },
        "scope_out": { "$ref": "#/$defs/stringList" },
        "dependencies": { "$ref": "#/$defs/stringList" },
        "inputs": { "$ref": "#/$defs/stringList" },
        "implementation_steps": { "$ref": "#/$defs/stringList" },
        "deliverables": { "$ref": "#/$defs/stringList" },
        "acceptance_criteria": { "$ref": "#/$defs/stringList" },
        "verification": { "$ref": "#/$defs/stringList" },
        "file_ownership": { "$ref": "#/$defs/stringList" },
        "estimate": { "type": "string", "minLength": 1 },
        "parallel_group": { "type": "string", "minLength": 1 },
        "human_approval_required": { "type": "boolean" },
        "approval": { "$ref": "#/$defs/approval" },
        "evidence": { "$ref": "#/$defs/stringList" },
        "blocker": { "$ref": "#/$defs/nullableString" },
        "notes": { "$ref": "#/$defs/stringList" },
        "created_at": { "$ref": "#/$defs/nullableTimestamp" },
        "updated_at": { "$ref": "#/$defs/nullableTimestamp" },
        "completed_at": { "$ref": "#/$defs/nullableTimestamp" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
