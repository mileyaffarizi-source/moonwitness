{
  "manifestVersion": "1.0.0",
  "id": "moonwitness.addon.reference",
  "name": "Reference Add-on",
  "version": "0.1.0",
  "description": "A minimal schema example for a reviewed first-party add-on capability.",
  "owner": {
    "team": "platform"
  },
  "license": "MIT",
  "compatibility": {
    "platformApi": ">=1.0.0 <2.0.0",
    "addonSdk": ">=1.0.0 <2.0.0",
    "node": ">=26.13.1 <27.0.0"
  },
  "dependencies": {
    "required": [],
    "optional": []
  },
  "capabilities": [
    "api.route"
  ],
